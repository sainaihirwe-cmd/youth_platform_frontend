# Base URL of the JobConnect Rwanda API.
# Local development (Vite proxies /api to http://localhost:5000):
VITE_API_URL=http://localhost:5000/api
# Tip: set VITE_API_URL=/api to go through the Vite dev proxy (same-origin cookies),
# or when the static host rewrites /api/* to the backend (recommended on Render).
